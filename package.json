{
	"name": "@uge/payo",
	"version": "2.5.0",
	"description": "One interview writes AGENTS.md and agent skills for your project, plus git and agent hooks that enforce them. Works with Claude Code, Cursor, Codex and Copilot.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/uttam-gelot/payo.git"
	},
	"homepage": "https://payo.uttamgelot.com/",
	"bugs": {
		"url": "https://github.com/uttam-gelot/payo/issues"
	},
	"module": "src/index.ts",
	"main": "dist/index.js",
	"bin": {
		"payo": "dist/index.js"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"embed:assets": "bun run scripts/embed-assets.ts",
		"build": "bun build src/index.ts --outdir dist --target node --minify",
		"postbuild": "chmod +x dist/index.js",
		"build:binaries": "bun run scripts/build-binaries.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "eslint src tests --ext .ts",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
		"prepack": "bun run build"
	},
	"engines": {
		"node": ">=20.12.0"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"cli",
		"ai",
		"rules",
		"skills",
		"agents-md",
		"agent-skills",
		"claude-code",
		"cursor",
		"copilot",
		"codex",
		"git-hooks",
		"code-review"
	],
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"@typescript-eslint/eslint-plugin": "^8",
		"@typescript-eslint/parser": "^8",
		"eslint": "^8",
		"eslint-config-prettier": "^9",
		"eslint-plugin-prettier": "^5",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3"
	}
}
